{
  "name": "tusan",
  "version": "0.2.0",
  "description": "Tusan! React number input where thousand separators are rendered by an OpenType font - the value stays a plain digit string, and caret/selection/copy/undo are fully native.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./roboto.css": "./fonts/roboto-grouped.css",
    "./jetbrains-mono.css": "./fonts/jetbrains-mono-grouped.css",
    "./fonts/*": "./fonts/*"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "fonts",
    "README.md",
    "LICENSE",
    "OFL.txt"
  ],
  "keywords": [
    "react",
    "number",
    "input",
    "thousand-separator",
    "digit-grouping",
    "opentype",
    "calt",
    "formatting",
    "i18n"
  ],
  "peerDependencies": {
    "react": ">=17"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.0",
    "jsdom": "^26.1.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.1",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davonium/tusan.git"
  },
  "homepage": "https://davonium.github.io/tusan/",
  "bugs": {
    "url": "https://github.com/davonium/tusan/issues"
  },
  "author": "David Johansson (davonium)"
}
